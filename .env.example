# ==========================================
# Persona & Event Organizing Committee Agent
# Configuration File (.env)
# ==========================================

# Active Agent Mode:
# 'persona' = Digital twin mimic for personal unavailable hours
# 'event'   = Organizing committee helpdesk for handling n DMs during events
# 'auto'    = Auto-detects (if sender mentions event keywords, runs event mode; else persona)
AGENT_MODE=persona
USER_NAME=Subho

# ==========================================
# LLM Provider Configuration
# ==========================================
# Provider: 'gemini' or 'openai'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# (Optional: If using OpenAI instead)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==========================================
# WhatsApp Integration (Green API - Primary)
# Docs: https://green-api.com/en/docs/
# ==========================================
# Webhook URL in Green API Console: https://<your-ngrok-or-domain>/whatsapp/green-api-webhook
WHATSAPP_PROVIDER=green_api
GREEN_API_INSTANCE_ID=your_green_api_instance_id
GREEN_API_API_TOKEN_INSTANCE=your_green_api_token_instance
GREEN_API_HOST=https://api.green-api.com

# ==========================================
# WhatsApp Alternative: Twilio Sandbox / Prod
# ==========================================
# Webhook URL to set in Twilio: https://<your-ngrok-or-domain>/whatsapp/webhook
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# (Optional: Meta WhatsApp Cloud API)
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=my_secure_webhook_verify_token

# ==========================================
# Email Notification Settings (Smart Hybrid)
# ==========================================
# SMTP Configuration (e.g. Gmail with App Password or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_USE_TLS=true

# Notification target (Where alerts & digests are sent)
NOTIFICATION_EMAIL_TO=your_personal_email@gmail.com
NOTIFICATION_FROM_NAME="Subho's Twin Agent"

# Smart Hybrid Alert Timing:
# Critical / Personal pings send an email INSTANTLY.
# Routine event FAQs during high-volume spikes get bundled into a digest.
DIGEST_INTERVAL_SECONDS=300
DIGEST_BATCH_SIZE=10
